# Anchorium RAG Pipeline — Environment Configuration
# Copy this file to .env and fill in your credentials.

# =============================================================
# API Keys (REQUIRED)
# =============================================================
ANCHORIUM_OPENAI_API_KEY=sk-your-openai-api-key-here
ANCHORIUM_PINECONE_API_KEY=your-pinecone-api-key-here
ANCHORIUM_COHERE_API_KEY=your-cohere-api-key-here

# Optional: LangSmith tracing
# ANCHORIUM_LANGSMITH_API_KEY=your-langsmith-api-key-here

# =============================================================
# Pinecone Configuration
# =============================================================
# ANCHORIUM_PINECONE_INDEX_NAME=anchorium-legal-rag
# ANCHORIUM_PINECONE_CLOUD=aws
# ANCHORIUM_PINECONE_REGION=us-east-1
# ANCHORIUM_PINECONE_DIMENSION=1536
# ANCHORIUM_PINECONE_METRIC=cosine
# ANCHORIUM_PINECONE_BATCH_SIZE=100

# =============================================================
# Embedding Configuration
# =============================================================
# ANCHORIUM_EMBEDDING_PROVIDER=openai
# ANCHORIUM_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# ANCHORIUM_EMBEDDING_BATCH_SIZE=64

# For VoyageAI (requires pip install 'anchorium-rag-pipeline[voyage]'):
# ANCHORIUM_EMBEDDING_PROVIDER=voyage
# ANCHORIUM_EMBEDDING_VOYAGE_MODEL=voyage-law-2
# ANCHORIUM_PINECONE_DIMENSION=1024
# ANCHORIUM_VOYAGE_API_KEY=your-voyage-api-key-here

# =============================================================
# Chunking Configuration
# =============================================================
# ANCHORIUM_CHUNKING_MAX_CHUNK_TOKENS=512
# ANCHORIUM_CHUNKING_OVERLAP_TOKENS=64
# ANCHORIUM_CHUNKING_MIN_CHUNK_TOKENS=50

# =============================================================
# Retrieval Configuration
# =============================================================
# ANCHORIUM_RETRIEVAL_ALPHA=0.4
# ANCHORIUM_RETRIEVAL_TOP_K_RAW=20
# ANCHORIUM_RETRIEVAL_TOP_K_RERANKED=5
# ANCHORIUM_RETRIEVAL_TEMPORAL_BOOST_FACTOR=0.1
# ANCHORIUM_RETRIEVAL_COHERE_RERANK_MODEL=rerank-v3.5

# =============================================================
# Generation Configuration
# =============================================================
# ANCHORIUM_GENERATION_MODEL_NAME=gpt-4o
# ANCHORIUM_GENERATION_TEMPERATURE=0.0
# ANCHORIUM_GENERATION_MAX_TOKENS=2048
# ANCHORIUM_GENERATION_VALIDATION_MAX_RETRIES=2
# ANCHORIUM_GENERATION_VALIDATION_MODEL=gpt-4o
# ANCHORIUM_GENERATION_CONTEXT_WINDOW_LIMIT=120000
